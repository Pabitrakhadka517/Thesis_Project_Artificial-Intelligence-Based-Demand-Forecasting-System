NODE_ENV=development
PORT=5000

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/stockwise

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate strong secrets in production:  openssl rand -hex 64
JWT_ACCESS_SECRET=replace_with_a_secure_random_string
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_string
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Password Reset ─────────────────────────────────────────────────────────────
# How long (minutes) the reset link stays valid
RESET_TOKEN_EXPIRE_MINUTES=30

# ── Email / SMTP (Nodemailer) — password reset ────────────────────────────────
# Required for sending password reset emails.
# Leave EMAIL_USER / EMAIL_PASS blank to disable email — the server will log
# the reset link to the console instead of sending it.
#
# Gmail with App Password (recommended):
#   1. Enable 2-Step Verification on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate an App Password → use it as EMAIL_PASS
#
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=StockWise <your_email@gmail.com>

# ── Cloudinary — image storage ────────────────────────────────────────────────
# Sign up free at https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Root folder (auto-created on first upload — no manual setup needed)
CLOUDINARY_FOLDER=stockwise
CLOUDINARY_PRODUCTS_FOLDER=stockwise/products
CLOUDINARY_CATEGORIES_FOLDER=stockwise/categories
CLOUDINARY_USERS_FOLDER=stockwise/users
CLOUDINARY_SUPPLIERS_FOLDER=stockwise/suppliers
CLOUDINARY_COMPANY_FOLDER=stockwise/company
CLOUDINARY_REPORTS_FOLDER=stockwise/reports

# ── AI Microservice ────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── Frontend origin (used in password-reset link generation) ──────────────────
FRONTEND_URL=http://localhost:5173
