# ── MongoDB ────────────────────────────────────────────────────────────────────
# Same database the Node.js API server connects to.
MONGO_URI=mongodb://localhost:27017/stockwise

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000
NODE_API_URL=http://localhost:5000

# ── Internal auth ──────────────────────────────────────────────────────────────
# This service has no user-facing auth of its own — every route requires this
# shared secret via the X-Internal-Api-Key header. Only the Node server's
# proxy (server/src/routes/ai.proxy.js) should ever call this service directly.
# Generate with: openssl rand -hex 32 — must match AI_SERVICE_API_KEY in server/.env.
AI_SERVICE_API_KEY=replace_with_a_secure_random_string

# ── LLM API Keys ───────────────────────────────────────────────────────────────
# Both are optional. The AI chat assistant falls back to the local BI engine
# (rule-based responses) if neither key is set — no crash, no silent failure.
#
# Anthropic Claude
#   Get a key: https://console.anthropic.com/settings/keys
#   The key starts with "sk-ant-api03-..."
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini Flash (primary LLM; Anthropic is the fallback)
#   Get a free key: https://aistudio.google.com/app/apikey
#   The key starts with "AIza..."
GEMINI_API_KEY=your-gemini-api-key-here

# Model overrides + retry/timeout tuning for the AI chat assistant.
# All optional — code defaults shown below (uncomment to change).
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GEMINI_MODEL=gemini-2.0-flash
# LLM_TIMEOUT_S=15
# LLM_MAX_RETRIES=3
# LLM_RETRY_DELAY_S=2

# ── Cloudinary — image storage ─────────────────────────────────────────────────
# The AI service uses Cloudinary only indirectly (shared config). The main
# upload/delete logic lives in the Node.js server. Copy these values from your
# Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Training data ──────────────────────────────────────────────────────────────
# Path to the CSV dataset used for ML training.
# Defaults to <repo_root>/training_data.csv — only set this if the
# file lives elsewhere.
# TRAINING_DATA_PATH=/absolute/path/to/training_data.csv

# Set true to enable RandomizedSearchCV hyperparameter tuning during model
# training (slower). Default: false (uses fixed, pre-tuned hyperparameters).
# TUNE_HYPERPARAMS=false
